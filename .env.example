# Leave blank to use the built-in sandbox. No real money moves in sandbox mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only database access. Never expose the service role key as NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Host phone OTP uses Supabase Auth. Enable the Phone provider and configure an SMS provider.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
	# WhatsApp Cloud API. Configure an approved booking template with one body variable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
